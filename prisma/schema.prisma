datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

/* =====================
   USER (NextAuth)
===================== */
model User {
  id             String   @id @default(cuid())
  name           String?
  email          String?  @unique
  emailVerified  DateTime?
  image          String?

  accounts       Account[]
  sessions       Session[]

  expenses       Expense[]
  budgetMembers  BudgetMember[]
  alertPreference AlertPreference?
}

/* =====================
   NEXTAUTH MODELS
===================== */
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/* =====================
   BUDGET
===================== */
model Budget {
  id       String @id @default(uuid())
  name     String
  month    String
  amount   Float

  members  BudgetMember[]
  expenses Expense[]
}

model BudgetMember {
  id       String @id @default(uuid())
  role     BudgetRole

  userId   String
  user     User   @relation(fields: [userId], references: [id])

  budgetId String
  budget   Budget @relation(fields: [budgetId], references: [id])
}

enum BudgetRole {
  OWNER
  EDITOR
  VIEWER
}

/* =====================
   CATEGORY
===================== */
model Category {
  id       String   @id @default(uuid())
  name     String
  expenses Expense[]
}

/* =====================
   PAYING ACCOUNT (CONT PLĂTITOR)
===================== */
model PayingAccount {
  id       String   @id @default(uuid())
  name     String
  balance  Float    @default(0)
  expenses Expense[]
}

/* =====================
   EXPENSE
===================== */
model Expense {
  id              String   @id @default(uuid())
  date            DateTime
  amount          Float
  details         String
  type            ExpenseType
  isRecurring     Boolean  @default(false)

  userId          String
  user            User     @relation(fields: [userId], references: [id])

  categoryId      String?
  category        Category? @relation(fields: [categoryId], references: [id])

  payingAccountId String?
  payingAccount   PayingAccount? @relation(fields: [payingAccountId], references: [id])

  budgetId        String?
  budget          Budget? @relation(fields: [budgetId], references: [id])

  createdAt       DateTime @default(now())
}

enum ExpenseType {
  PERSONAL
  BUSINESS
}

/* =====================
   ALERTS
===================== */
model AlertPreference {
  id            String @id @default(uuid())
  userId        String @unique
  user          User   @relation(fields: [userId], references: [id])

  emailEnabled  Boolean @default(true)
  threshold     Int     @default(80)
}